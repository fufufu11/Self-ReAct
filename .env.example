# Self-ReAct 本地配置模板
#
# 使用方式：复制本文件为 .env（.env 已被 .gitignore 忽略，不会提交），
# 然后在当前终端手动加载 .env 中的变量（见 README 的"配置"一节）。
#
# 说明：代码只在运行时从进程环境变量读取密钥；hello、example 与
# run --model fake 不需要密钥，只有 run --model deepseek / run --model openai
# 会读取对应密钥。

DEEPSEEK_API_KEY=sk-你的密钥
OPENAI_API_KEY=sk-你的密钥
# 可选：OpenAI 兼容中转地址（不设置时用官方地址）
# OPENAI_BASE_URL=https://中转地址/v1
